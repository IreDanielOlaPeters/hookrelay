<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Values are set in both $_ENV and $_SERVER: Laravel's env() reads $_SERVER first,
             and the container already defines DB_DATABASE etc. there.
             Tests run against real Postgres (SKIP LOCKED) and Redis (token bucket, circuit breaker). -->
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <server name="APP_URL" value="http://localhost" force="true"/>
        <env name="APP_KEY" value="base64:Hr3B76dIUXyBys2e3c2r1nGACL3Fjlhu1DtO0l/nENk=" force="true"/>
        <server name="APP_KEY" value="base64:Hr3B76dIUXyBys2e3c2r1nGACL3Fjlhu1DtO0l/nENk=" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="hookrelay_test" force="true"/>
        <server name="DB_DATABASE" value="hookrelay_test" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="REDIS_DB" value="14" force="true"/>
        <server name="REDIS_DB" value="14" force="true"/>
        <env name="REDIS_PREFIX" value="hookrelay_test_" force="true"/>
        <server name="REDIS_PREFIX" value="hookrelay_test_" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <server name="LOG_CHANNEL" value="null" force="true"/>
        <env name="DEMO_MODE" value="false" force="true"/>
        <server name="DEMO_MODE" value="false" force="true"/>
        <env name="ADMIN_TOKEN" value="test-admin-token" force="true"/>
        <server name="ADMIN_TOKEN" value="test-admin-token" force="true"/>
        <env name="RELAY_OUTBOUND_SECRET" value="test-outbound-secret" force="true"/>
        <server name="RELAY_OUTBOUND_SECRET" value="test-outbound-secret" force="true"/>
        <env name="RELAY_BACKOFF_BASE_SECONDS" value="30" force="true"/>
        <server name="RELAY_BACKOFF_BASE_SECONDS" value="30" force="true"/>
        <env name="RELAY_BACKOFF_FACTOR" value="4" force="true"/>
        <server name="RELAY_BACKOFF_FACTOR" value="4" force="true"/>
        <env name="RELAY_BACKOFF_CAP_SECONDS" value="21600" force="true"/>
        <server name="RELAY_BACKOFF_CAP_SECONDS" value="21600" force="true"/>
    </php>
</phpunit>
