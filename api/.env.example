# Copy to .env only when running the API outside Docker Compose.
# Inside Compose these values come from docker-compose.yml (and the root .env).
APP_NAME=HookRelay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hookrelay
DB_USERNAME=hookrelay
DB_PASSWORD=hookrelay

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=array

# Bearer token for the management API (/api/*). Use a long random string.
ADMIN_TOKEN=
# Public demo mode: demo user, banner, nightly reset. Keep false for real installs.
DEMO_MODE=false
DEMO_DESTINATION_HOSTS=mock-receiver
RELAY_SESSION_MINUTES=720

# Secret for X-HookRelay-Signature on outbound deliveries.
RELAY_OUTBOUND_SECRET=

# Retry schedule (seconds): full jitter over min(cap, base * factor^(attempt-1)).
RELAY_BACKOFF_BASE_SECONDS=30
RELAY_BACKOFF_FACTOR=4
RELAY_BACKOFF_CAP_SECONDS=21600
RELAY_DISPATCH_BATCH=100
RELAY_DISPATCH_INTERVAL=2
RELAY_STUCK_AFTER_SECONDS=300
RELAY_CIRCUIT_THRESHOLD=5
RELAY_CIRCUIT_OPEN_SECONDS=60

RELAY_SSRF_ALLOWLIST=
RELAY_MAX_BODY_BYTES=2097152
RELAY_INGEST_DEFAULT_RPS=

RELAY_ALERT_SLACK_WEBHOOK_URL=
RELAY_ALERT_EMAIL=
RELAY_ALERT_COOLDOWN_SECONDS=900
RELAY_DASHBOARD_URL=http://localhost:3000
RELAY_METRICS_TOKEN=
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
DB_PERSISTENT=false
LARAVEL_OPTIMIZE=true
