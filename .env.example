# Root .env is read by docker compose for variable substitution.
# Every value has a development default in docker-compose.yml; set real ones before exposing HookRelay.

# Laravel app key: `docker compose run --rm api php artisan key:generate --show`
APP_KEY=
APP_ENV=local
APP_URL=http://localhost:8080
# Bearer token for the management API and the dashboard's server-side calls.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Public demo mode (demo user demo@hookrelay.local / hookrelay-demo, banner, nightly reset).
# The credentials are public: set false for any real installation.
DEMO_MODE=true
# Create the full-access admin with: docker compose exec api php artisan relay:admin you@example.com --generate

# Secret used for X-HookRelay-Signature on outbound deliveries.
RELAY_OUTBOUND_SECRET=change-me-too
POSTGRES_PASSWORD=hookrelay

# Retry schedule in seconds (defaults: 30 / 4 / 21600). Lower the base for demos.
RELAY_BACKOFF_BASE_SECONDS=30
RELAY_BACKOFF_FACTOR=4
RELAY_BACKOFF_CAP_SECONDS=21600

WORKER_REPLICAS=2
API_PORT=8080
DASHBOARD_PORT=3000
MOCK_RECEIVER_PORT=4000

# SSRF guard: destinations can't target private/loopback/link-local/metadata/IPv6 ULA addresses
# unless allowed here (comma-separated hostnames, *.suffix wildcards, IPs or CIDRs).
RELAY_SSRF_ALLOWLIST=mock-receiver
# Ingestion limits: max body (bytes) -> 413; default per-source requests/second -> 429 (empty = unlimited).
RELAY_MAX_BODY_BYTES=2097152
RELAY_INGEST_DEFAULT_RPS=

# Alerts (delivery dead, circuit breaker opened): Slack incoming webhook and/or email, one per
# destination per cooldown. Email uses MAIL_MAILER/MAIL_HOST/... (Laravel mail settings).
RELAY_ALERT_SLACK_WEBHOOK_URL=
RELAY_ALERT_EMAIL=
RELAY_ALERT_COOLDOWN_SECONDS=900
RELAY_DASHBOARD_URL=http://localhost:3000
# Optional bearer token for GET /metrics (otherwise restrict it at your proxy).
RELAY_METRICS_TOKEN=

# Reuse one Postgres connection per API thread (set for the api service in docker-compose.yml).
# DB_PERSISTENT=true
